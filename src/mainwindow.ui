                       <property name="plainText">
                        <string>#include &lt;iostream&gt;

int main(int, char**)
{
    char c1 = 'a';
    decltype(c1) c2 = c1;
    ++c2;
    decltype((c1)) c3 = c1;
    ++c3;

    std::cout &lt;&lt; c1 &lt;&lt; c2 &lt;&lt; c3 &lt;&lt; std::endl;
    return 0;
}</string>
