QRadioButton:hover {
    background-color: rgb(22, 30, 32);
    border-color: rgb(51, 64, 63);
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 8px;
    border: 2px solid rgb(51, 64, 63);
    background-color: rgb(17, 23, 24);
}

QRadioButton::indicator:hover {
}

QRadioButton:checked {
	background-color: rgb(29, 27, 20);
    border: 2px solid rgb(229, 159, 50);
}

QRadioButton::indicator:checked {
    width: 14px;
    height: 14px;
    border-radius: 8px;
    background-color: rgb(255, 179, 57);
    border: 2px solid rgb(190, 127, 0);
}
