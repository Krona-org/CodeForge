    border: 2px solid rgb(80, 200, 120);
    background-color: rgb(20, 40, 28);
}
QRadioButton[resultState=&quot;wrong&quot;] {
    border: 2px solid rgb(220, 80, 80);
    background-color: rgb(40, 20, 20);
}</string>
